    "z": "tab-nuki-01",
    "name": "Pairing Code",
    "props": [
      { "p": "payload" }
    ],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0,
    "topic": "",
    "payload": "{\"pairingCode\":\"12345-678-9012\"}",
    "payloadType": "json",
    "x": 150,
